# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret used to sign user authentication session tokens.
JWT_SECRET="meetspace-dev-jwt-secret-key-change-in-production"

# STUN_SERVER_URL: STUN server for WebRTC NAT traversal.
STUN_SERVER_URL="stun:stun.l.google.com:19302"

# TURN_SERVER_URL: Optional TURN server for relaying media across symmetric firewalls.
TURN_SERVER_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

